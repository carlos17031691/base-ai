src/*
!src/.gitkeep
.ai/context-index.json
# Six task files per ticket are versioned so CI can check them on the PR (BASE-071-P3); evidence/ and
# anything else under a task directory stays local. Unattributed usage in .ai/usage/ is ignored
.ai/tasks/*
!.ai/tasks/*/
.ai/tasks/*/*
!.ai/tasks/*/usage.jsonl
!.ai/tasks/*/status.json
!.ai/tasks/*/plan.md
!.ai/tasks/*/review-report.md
!.ai/tasks/*/qa-report.md
!.ai/tasks/*/decisions.md
!.ai/tasks/*/improvement-report.md
.ai/usage/
# Legacy task directories (before BASE-071-P3) stay local; only their usage.jsonl is versioned
.ai/tasks/BASE-046-C1/*
!.ai/tasks/BASE-046-C1/usage.jsonl
