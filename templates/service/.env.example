# 12-Factor service configuration ({{name}})
# Copy to .env for local development. Never commit .env to Git.

SERVICE_NAME={{name}}
APP_ENV=development
PORT=3000
LOG_LEVEL=info

# Database / Cache (optional — set per service)
# DATABASE_URL=postgres://user:password@localhost:5432/{{name}}
# REDIS_URL=redis://localhost:6379/0

# AI Gateway / LLM provider & token budgets (optional — see `integrations` & `ai-ops` skills)
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=
# AI_MODEL_FAST=openai/gpt-4o-mini
# AI_MODEL_PRIMARY=anthropic/claude-3.7-sonnet
# AI_MODEL_REASONING=anthropic/claude-3.7-sonnet:thinking
# AI_MODEL_FALLBACK=google/gemini-2.5-flash
# AI_MAX_OUTPUT_TOKENS=1024
# AI_DAILY_BUDGET_USD=25.00
# AI_TIMEOUT_MS=15000
