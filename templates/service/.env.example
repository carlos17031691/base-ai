# 12-Factor service configuration ({{name}})
# Copy to .env for local development. Never commit .env to Git.

SERVICE_NAME={{name}}
APP_ENV=development
PORT=3000
LOG_LEVEL=info

# Database / Cache (optional — set per service)
# DATABASE_URL=postgres://user:password@localhost:5432/{{name}}
# REDIS_URL=redis://localhost:6379/0

# AI Gateway / LLM provider (optional — e.g. OpenRouter, LiteLLM)
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=
# AI_MODEL_PRIMARY=anthropic/claude-3.7-sonnet
# AI_MODEL_FALLBACK=openai/gpt-4o-mini
# AI_TIMEOUT_MS=15000
